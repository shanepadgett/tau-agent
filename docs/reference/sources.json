{
  "ignore": [],
  "sources": [
    {
      "package": "effect",
      "versionSource": "lock",
      "summary": "Effect 4: typed effects, services and layers, Schema, Stream, errors. Read the examples before writing Effect code; the module list names every API.",
      "docs": [
        {
          "origin": { "kind": "installed" },
          "files": ["README.md", "AGENTS.md", "ai-docs/src/**/*.md", "ai-docs/src/**/*.ts"]
        }
      ],
      "api": [{ "kind": "source", "path": "effect/src" }]
    },
    {
      "package": "@effect/tsgo",
      "versionSource": "lock",
      "summary": "Effect diagnostics for the TypeScript 7 compiler: rule names, severities and tsconfig options.",
      "docs": [
        { "origin": { "kind": "installed" }, "files": ["README.md"] },
        {
          "origin": {
            "kind": "git",
            "repository": "https://github.com/Effect-TS/tsgo.git",
            "ref": { "tag": "@effect/tsgo@{version}" }
          },
          "files": ["docs/**/*.md"]
        }
      ],
      "api": [
        { "kind": "schema", "path": "@effect/tsgo/schema.json" },
        { "kind": "schema", "path": "@effect/tsgo/oxlint-schema.json" }
      ]
    },
    {
      "package": "typescript",
      "versionSource": "lock",
      "summary": "TypeScript 7 (native compiler). Only the README is copied: compiler-option docs have no versioned source.",
      "docs": [{ "origin": { "kind": "installed" }, "files": ["README.md"] }],
      "api": []
    },
    {
      "package": "@types/bun",
      "versionSource": "lock",
      "summary": "Type definitions for Bun's APIs. The declarations are the API reference.",
      "docs": [{ "origin": { "kind": "installed" }, "files": ["README.md"] }],
      "api": [{ "kind": "types", "path": "bun-types" }]
    },
    {
      "package": "oxlint",
      "versionSource": "lock",
      "summary": "Linter: configuration, rules and their options, and the JS plugin guide. The website pages are unversioned.",
      "docs": [
        { "origin": { "kind": "installed" }, "files": ["README.md"] },
        {
          "origin": {
            "kind": "git",
            "repository": "https://github.com/oxc-project/website.git",
            "ref": { "branch": "main" }
          },
          "files": ["src/docs/guide/usage/linter.md", "src/docs/guide/usage/linter/**/*.md"]
        }
      ],
      "api": [{ "kind": "schema", "path": "oxlint/configuration_schema.json" }]
    },
    {
      "package": "@oxlint/plugins",
      "versionSource": "lock",
      "summary": "Types for writing Oxlint JS plugins: rules, the AST, `context` and `sourceCode`.",
      "docs": [{ "origin": { "kind": "installed" }, "files": ["README.md"] }],
      "api": [{ "kind": "types", "path": "@oxlint/plugins/index.d.ts" }]
    },
    {
      "package": "oxlint-tsgolint",
      "versionSource": "lock",
      "summary": "Type-aware lint rules for Oxlint.",
      "docs": [{ "origin": { "kind": "installed" }, "files": ["README.md"] }],
      "api": []
    },
    {
      "package": "oxfmt",
      "versionSource": "lock",
      "summary": "Formatter: options, ignore files and supported languages. The website pages are unversioned.",
      "docs": [
        { "origin": { "kind": "installed" }, "files": ["README.md"] },
        {
          "origin": {
            "kind": "git",
            "repository": "https://github.com/oxc-project/website.git",
            "ref": { "branch": "main" }
          },
          "files": ["src/docs/guide/usage/formatter.md", "src/docs/guide/usage/formatter/**/*.md"]
        }
      ],
      "api": [{ "kind": "schema", "path": "oxfmt/configuration_schema.json" }]
    },
    {
      "package": "fallow",
      "versionSource": "lock",
      "summary": "Dead code, duplication and import boundaries: CLI, issue types, patterns and gotchas.",
      "docs": [
        {
          "origin": { "kind": "installed" },
          "files": ["README.md", "skills/fallow/SKILL.md", "skills/fallow/references/*.md"]
        }
      ],
      "api": [
        { "kind": "schema", "path": "fallow/schema.json" },
        { "kind": "schema", "path": "fallow/capabilities.json" }
      ]
    },
    {
      "package": "bun",
      "versionSource": "mise",
      "summary": "Bun runtime: file, spawn, sqlite, test runner, glob, bundler and compile.",
      "docs": [
        {
          "origin": {
            "kind": "git",
            "repository": "https://github.com/oven-sh/bun.git",
            "ref": { "tag": "bun-v{version}" }
          },
          "files": ["docs/**/*.md", "docs/**/*.mdx"]
        }
      ],
      "api": []
    },
    {
      "package": "node",
      "versionSource": "mise",
      "summary": "Node.js API docs. Prefer Bun's built-ins and Effect; use `node:` modules where Bun implements them.",
      "docs": [
        {
          "origin": {
            "kind": "git",
            "repository": "https://github.com/nodejs/node.git",
            "ref": { "tag": "v{version}" }
          },
          "files": ["doc/api/*.md"]
        }
      ],
      "api": []
    }
  ]
}
