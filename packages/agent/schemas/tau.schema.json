{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/shanepadgett/tau-agent/refs/heads/main/packages/agent/schemas/tau.schema.json",
	"title": "Tau Configuration",
	"description": "Configuration for Tau and Tau extensions.",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "Optional schema reference used by editors for validation and autocomplete."
		},
		"extensions": {
			"type": "object",
			"properties": {
				"context": {
					"type": "object",
					"properties": {
						"sync": {
							"type": "object",
							"properties": {
								"enabled": {
									"type": "boolean",
									"default": true,
									"description": "Master switch for context-sync. When false: no /context-sync, parent cannot call the agent, validation does not auto-run sync."
								},
								"automation": {
									"type": "boolean",
									"default": true,
									"description": "When true with sync.enabled, the coding agent may call context-sync. When false, only manual /context-sync (validation auto-run still allowed if validation.enabled)."
								}
							},
							"additionalProperties": false
						},
						"validation": {
							"type": "object",
							"properties": {
								"enabled": {
									"type": "boolean",
									"default": false,
									"description": "Validate context membership after agent turns and auto-run context-sync on failure (requires sync.enabled)."
								},
								"ignoreGlobs": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"default": [],
									"description": "Project-relative files excluded from context membership validation and sync."
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"continuity": {
					"type": "object",
					"properties": {
						"showToolRows": {
							"type": "boolean",
							"default": false,
							"description": "Show continuity checkpoint and injected-file rows in the TUI for debugging."
						}
					},
					"additionalProperties": false
				},
				"explore": {
					"type": "object",
					"properties": {
						"context": {
							"type": "object",
							"properties": {
								"defaultBudgetTokens": {
									"type": "integer",
									"default": 8000,
									"minimum": 1,
									"description": "Default token budget for context when the caller omits budget."
								}
							},
							"additionalProperties": false
						},
						"read": {
							"type": "object",
							"properties": {
								"enabled": {
									"type": "boolean",
									"default": true,
									"description": "Master switch for Explore structural read overlay and large-source autoread outline path. When false, Pi read and autoread keep ordinary full bodies."
								},
								"structureThresholdLines": {
									"type": "integer",
									"default": 200,
									"minimum": 1,
									"description": "Registered source at or under this line count may be full-read. Above it, full read model-visible result is outline only."
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				"footer": {
					"type": "object",
					"properties": {
						"enabled": {
							"type": "boolean",
							"default": true,
							"description": "Enable Tau's compact footer."
						}
					},
					"additionalProperties": false
				},
				"modelFallback": {
					"type": "object",
					"properties": {
						"cooldowns": {
							"type": "object",
							"patternProperties": {
								"^.*$": {
									"type": "number",
									"description": "Unix epoch milliseconds when the provider becomes available again."
								}
							}
						}
					},
					"additionalProperties": false
				},
				"reference": {
					"type": "object",
					"properties": {
						"editor": {
							"anyOf": [
								{
									"type": "string",
									"const": "default"
								},
								{
									"type": "string",
									"const": "code"
								},
								{
									"type": "string",
									"const": "zed"
								}
							],
							"default": "default",
							"description": "Editor used by the reference picker open action. default uses $VISUAL, $EDITOR, then code."
						},
						"branchChoices": {
							"type": "integer",
							"default": 5,
							"minimum": 1,
							"maximum": 50,
							"description": "Maximum branch choices shown when switching a reference branch."
						}
					},
					"additionalProperties": false
				},
				"silentCommandRunner": {
					"type": "object",
					"properties": {
						"enabled": {
							"type": "boolean",
							"default": true,
							"description": "Enable silent command runner."
						},
						"maxOutputBytes": {
							"type": "integer",
							"default": 51200,
							"minimum": 1,
							"description": "Maximum raw stdout/stderr bytes sent to the agent."
						},
						"commands": {
							"type": "array",
							"items": {
								"type": "object",
								"required": [
									"name",
									"command"
								],
								"properties": {
									"name": {
										"type": "string",
										"description": "Short command name shown in notifications and failure messages."
									},
									"enabled": {
										"type": "boolean",
										"default": true,
										"description": "Enable this command."
									},
									"command": {
										"type": "string",
										"description": "Shell command run with sh -lc after matching files change."
									},
									"cwd": {
										"type": "string",
										"default": ".",
										"description": "Command working directory, relative to project root."
									},
									"env": {
										"type": "object",
										"patternProperties": {
											"^.*$": {
												"type": "string"
											}
										},
										"description": "Extra environment values."
									},
									"details": {
										"type": "string",
										"description": "Free-text explanation of what this command checks or runs."
									},
									"includeGlobs": {
										"type": "array",
										"items": {
											"type": "string"
										},
										"default": [
											"**/*"
										],
										"description": "Project-relative files that trigger this command."
									},
									"excludeGlobs": {
										"type": "array",
										"items": {
											"type": "string"
										},
										"default": [],
										"description": "Project-relative files ignored for this command."
									},
									"timeoutMs": {
										"type": "integer",
										"default": 120000,
										"minimum": 1,
										"description": "Command timeout in milliseconds."
									}
								},
								"additionalProperties": false
							},
							"default": [],
							"description": "Commands run after matched files change."
						}
					},
					"additionalProperties": false
				},
				"soul": {
					"type": "object",
					"properties": {
						"ponytail": {
							"type": "boolean",
							"default": true,
							"description": "Add the lazy-senior-dev build ethos to Tau's system prompt."
						},
						"caveman": {
							"type": "boolean",
							"default": true,
							"description": "Add the terse communication style to Tau's system prompt."
						}
					},
					"additionalProperties": false
				},
				"subagent": {
					"type": "object",
					"properties": {
						"disabled": {
							"type": "array",
							"items": {
								"type": "string",
								"minLength": 1
							},
							"default": [],
							"description": "Agent names unavailable for delegation."
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": true,
			"default": {}
		}
	},
	"additionalProperties": false
}
