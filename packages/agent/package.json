{
	"name": "@shanepadgett/tau-agent",
	"version": "0.58.2",
	"description": "Tau is a custom agentic harness built with pi extensions",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"license": "MIT",
	"keywords": [
		"pi-package",
		"tau",
		"coding-agent"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shanepadgett/tau-agent.git",
		"directory": "packages/agent"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src/**/*",
		"extensions/**/*",
		"shared/**/*",
		"prompts/**/*",
		"skills/**/*",
		"themes/**/*",
		"docs/**/*",
		"schemas/**/*",
		"README.md"
	],
	"dependencies": {
		"@shanepadgett/tau-tui": "0.58.2",
		"htmlparser2": "12.0.0",
		"image-size": "2.0.4",
		"markdownlint-cli2": "0.22.1",
		"semver": "7.8.5",
		"turndown": "7.2.4",
		"turndown-plugin-gfm": "1.0.2",
		"unbash": "4.0.11"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.1.0",
		"@earendil-works/pi-coding-agent": ">=1.1.0",
		"@earendil-works/pi-tui": ">=1.1.0",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/*/index.ts"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts"
		],
		"themes": [
			"./themes"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/semver": "7.8.0",
		"@types/turndown": "5.0.6"
	}
}
