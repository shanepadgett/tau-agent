{
  "$schema": "./node_modules/fallow/schema.json",
  // Fallow owns dead code, import boundaries and duplicates only.
  // Health, complexity and CRAP checks are excluded as too noisy.
  "ignorePatterns": ["spikes/**", "docs/reference/copies/**"],
  "rulePacks": ["tools/fallow/imports.jsonc"],
  "entry": [
    "tools/reference-docs.ts",
    "tools/reference-check.ts",
    "tools/file-names-check.ts",
    "tools/report-failures.ts",
    "tools/catalog-snapshot.ts",
  ],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "policy-violation": "error",
  },
  "duplicates": { "mode": "mild", "minTokens": 50, "minLines": 5, "minOccurrences": 2 },
  "boundaries": {
    // Layer import rules from docs/plan/architecture.md. Same-layer imports are
    // always allowed. Type-only imports follow the same allowlists. Each layer has
    // two zones: its public modules at the root and its internal/ folder, which only
    // the layer itself may import.
    "zones": [
      { "name": "cli", "patterns": ["src/cli/*.ts"] },
      { "name": "cli-internal", "patterns": ["src/cli/internal/**"] },
      { "name": "tui", "patterns": ["src/tui/*.ts", "src/tui/*.tsx"] },
      { "name": "tui-internal", "patterns": ["src/tui/internal/**"] },
      { "name": "supervisor", "patterns": ["src/supervisor/*.ts"] },
      { "name": "supervisor-internal", "patterns": ["src/supervisor/internal/**"] },
      { "name": "extensions", "patterns": ["src/extensions/*.ts"] },
      { "name": "extensions-internal", "patterns": ["src/extensions/internal/**"] },
      { "name": "host", "patterns": ["src/host/*.ts"] },
      { "name": "host-internal", "patterns": ["src/host/internal/**"] },
      { "name": "sdk", "patterns": ["src/sdk/*.ts"] },
      { "name": "sdk-internal", "patterns": ["src/sdk/internal/**"] },
      { "name": "core", "patterns": ["src/core/*.ts"] },
      { "name": "core-internal", "patterns": ["src/core/internal/**"] },
      { "name": "session", "patterns": ["src/session/*.ts"] },
      { "name": "session-internal", "patterns": ["src/session/internal/**"] },
      { "name": "database", "patterns": ["src/database/*.ts"] },
      { "name": "database-internal", "patterns": ["src/database/internal/**"] },
      { "name": "sandbox", "patterns": ["src/sandbox/*.ts"] },
      { "name": "sandbox-internal", "patterns": ["src/sandbox/internal/**"] },
      { "name": "proc", "patterns": ["src/proc/*.ts"] },
      { "name": "proc-internal", "patterns": ["src/proc/internal/**"] },
      { "name": "workspace", "patterns": ["src/workspace/*.ts"] },
      { "name": "workspace-internal", "patterns": ["src/workspace/internal/**"] },
      { "name": "ai", "patterns": ["src/ai/*.ts"] },
      { "name": "ai-internal", "patterns": ["src/ai/internal/**"] },
      { "name": "tools", "patterns": ["tools/**"] },
      { "name": "tests", "patterns": ["tests/**"] },
    ],
    "rules": [
      {
        "from": "cli",
        "allow": [
          "cli-internal",
          "tui",
          "supervisor",
          "extensions",
          "host",
          "sdk",
          "core",
          "session",
          "database",
          "sandbox",
          "proc",
          "workspace",
          "ai",
        ],
      },
      { "from": "tui", "allow": ["tui-internal", "core", "sdk"] },
      { "from": "extensions", "allow": ["extensions-internal", "sdk"] },
      { "from": "host", "allow": ["host-internal", "sdk", "core", "session", "database", "ai"] },
      { "from": "sdk", "allow": ["sdk-internal", "core", "ai"] },
      {
        "from": "core",
        "allow": ["core-internal", "session", "sandbox", "proc", "workspace", "ai"],
      },
      { "from": "session", "allow": ["session-internal", "database", "ai"] },
      { "from": "database", "allow": ["database-internal"] },
      { "from": "sandbox", "allow": ["sandbox-internal"] },
      { "from": "proc", "allow": ["proc-internal"] },
      { "from": "workspace", "allow": ["workspace-internal", "proc"] },
      { "from": "ai", "allow": ["ai-internal"] },
      {
        "from": "cli-internal",
        "allow": [
          "cli",
          "tui",
          "supervisor",
          "extensions",
          "host",
          "sdk",
          "core",
          "session",
          "database",
          "sandbox",
          "proc",
          "workspace",
          "ai",
        ],
      },
      // The supervisor must keep running when Tau's own code is broken, so it loads no other layer
      // except proc, which starts the chat process.
      { "from": "supervisor", "allow": ["supervisor-internal", "proc"] },
      { "from": "supervisor-internal", "allow": ["supervisor"] },
      { "from": "tui-internal", "allow": ["tui", "core", "sdk"] },
      { "from": "extensions-internal", "allow": ["extensions", "sdk"] },
      { "from": "host-internal", "allow": ["host", "sdk", "core", "session", "database", "ai"] },
      { "from": "sdk-internal", "allow": ["sdk", "core", "ai"] },
      {
        "from": "core-internal",
        "allow": ["core", "session", "sandbox", "proc", "workspace", "ai"],
      },
      { "from": "session-internal", "allow": ["session", "database", "ai"] },
      { "from": "database-internal", "allow": ["database"] },
      { "from": "sandbox-internal", "allow": ["sandbox"] },
      { "from": "proc-internal", "allow": ["proc"] },
      { "from": "workspace-internal", "allow": ["workspace", "proc"] },
      { "from": "ai-internal", "allow": ["ai"] },
      { "from": "tools", "allow": [] },
      {
        "from": "tests",
        "allow": [
          // Until the HTTP fake provider exists, login tests read signed headers
          // from the internal signer. See docs/plan/deferred.md.
          "ai-internal",
          "cli",
          "tui",
          "supervisor",
          "extensions",
          "host",
          "sdk",
          "core",
          "session",
          "database",
          "sandbox",
          "proc",
          "workspace",
          "ai",
        ],
      },
    ],
    "coverage": { "requireAllFiles": true },
  },
}
