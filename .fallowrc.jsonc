// lean: .pi/extensions/ are first-party consumers (per AGENTS.md). Fallow only
// descends into that dot dir because package.json scripts reference
// .pi/extensions/.fallow-scope.ts.
{
  "entry": [
    ".pi/extensions/*/index.ts",
    "packages/agent/extensions/*/index.ts",
    "packages/agent/src/index.ts",
    "packages/tui/src/index.ts",
    "packages/agent/scripts/generate-tau-schema.ts",
    "packages/agent/scripts/build-grammars.ts",
    "packages/agent/scripts/check-package-sources.ts"
  ],
  "includeEntryExports": true,
  // Archive is frozen prior art under docs/; not part of the live graph.
  // Grammar wasm packages are resolved by path/bin, not static import.
  "ignorePatterns": [
    "packages/agent/shared/description.ts",
    "packages/agent/shared/injected-context.ts",
    "packages/agent/src/ast/languages/fixtures/**",
    "docs/plans/explore-archive/**"
  ],
  "ignoreDependencies": ["@vscode/tree-sitter-wasm", "tree-sitter-cli"],
  "duplicates": {
    // Grammar adapters are parallel by design: each one maps a different
    // tree-sitter node vocabulary through the same shape. Shared behavior lives
    // in languages/tree.ts; the rest must stay free to diverge per grammar.
    // Tests repeat fixtures and arrange blocks on purpose.
    // Panel classes repeat ToolPanel construction plus render/invalidate
    // delegation. A base class cannot absorb it: their config literals read
    // `this`, which TypeScript forbids before `super()`.
    "ignore": [
      "packages/agent/src/ast/languages/*.ts",
      "packages/agent/test/**",
      "packages/agent/extensions/*/panel.ts"
    ]
  },
  "ignoreExports": [
    {
      "file": "packages/agent/extensions/*/index.ts",
      "exports": ["default"]
    },
    {
      "file": ".pi/extensions/*/index.ts",
      "exports": ["default"]
    }
  ],
  "usedClassMembers": [
    { "implements": "Component", "members": ["handleInput", "invalidate"] },
    { "implements": "Focusable", "members": ["focused"] }
  ]
}
