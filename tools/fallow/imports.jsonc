{
  "$schema": "../../node_modules/fallow/rule-pack-schema.json",
  "version": 1,
  "name": "tau-imports",
  "description": "Module imports owned by one layer.",
  "rules": [
    {
      "id": "sqlite-in-database",
      "kind": "banned-import",
      "specifiers": ["bun:sqlite"],
      "files": ["**"],
      "exclude": ["src/database/**"],
      "message": "Open SQLite only in the database layer. Use openDatabase from other layers.",
      "severity": "error",
    },
  ],
}
