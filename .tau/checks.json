{
  "fix": [
    {
      "name": "Lint fixes",
      "command": "mise run fix:lint -- {files}",
      "details": "Apply safe lint fixes to changed source, tools and tests.",
      "include": [
        "src/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "tools/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "tests/**/*.{ts,tsx,js,jsx,mjs,cjs}"
      ]
    },
    {
      "name": "Formatting fixes",
      "command": "mise run fix:fmt -- {files}",
      "details": "Format changed code and supported configuration after lint fixes.",
      "include": [
        "src/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "tools/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "tests/**/*.{ts,tsx,js,jsx,mjs,cjs}",
        "tools/**/*.json",
        "tools/**/*.jsonc",
        "package.json",
        "tsconfig.json",
        ".oxlintrc.json",
        ".oxfmtrc.json",
        ".fallowrc.jsonc",
        ".pi/tau/settings.json",
        "docs/reference/sources.json"
      ]
    }
  ],
  "check": [
    {
      "name": "Mise task configuration",
      "command": "mise run check:mise",
      "details": "Validate task names, dependencies and commands.",
      "include": ["mise.toml"]
    },
    {
      "name": "Formatting",
      "command": "mise run check:fmt",
      "details": "Check code and supported configuration formatting.",
      "include": [
        "src/**",
        "tools/**",
        "tests/**",
        "package.json",
        "tsconfig.json",
        ".oxlintrc.json",
        ".oxfmtrc.json",
        ".fallowrc.jsonc",
        ".pi/tau/settings.json",
        "docs/reference/sources.json",
        ".gitignore"
      ],
      "exclude": ["**/*.md"]
    },
    {
      "name": "Lint",
      "command": "mise run check:lint",
      "details": "Check type-aware and layer-scoped lint policies.",
      "include": [
        "src/**",
        "tools/**",
        "tests/**",
        ".oxlintrc.json",
        "tsconfig.json",
        "package.json",
        "bun.lock",
        "mise.toml"
      ],
      "exclude": ["**/*.md"],
      "timeoutSeconds": 300
    },
    {
      "name": "Type checking",
      "command": "mise run check:types",
      "details": "Run the patched TypeScript compiler and Effect diagnostics.",
      "include": [
        "src/**",
        "tools/**",
        "tests/**",
        "tsconfig.json",
        "package.json",
        "bun.lock",
        "mise.toml"
      ],
      "exclude": ["**/*.md"],
      "timeoutSeconds": 300
    },
    {
      "name": "Reference documentation",
      "command": "mise run check:reference",
      "details": "Check that every dependency has reference docs matching its pinned version.",
      "include": [
        "docs/reference/sources.json",
        "tools/reference/**",
        "tools/reference-docs.ts",
        "tools/reference-check.ts",
        "package.json",
        "bun.lock",
        "mise.toml"
      ]
    },
    {
      "name": "File names",
      "command": "mise run check:file-names",
      "details": "Check that Git tracks each file under its name on disk, and that src/ file names follow the layer layout.",
      "include": ["src/**", "tests/**", "tools/**", "mise.toml"]
    },
    {
      "name": "Application tests",
      "command": "mise run test",
      "details": "Run the application's integration tests.",
      "include": ["src/**", "tests/**", "package.json", "bun.lock", "mise.toml", "tsconfig.json"],
      "exclude": ["**/*.md"],
      "timeoutSeconds": 300
    },
    {
      "name": "Lint rule tests",
      "command": "mise run test:rules",
      "details": "Run the Tau lint rules' unit tests.",
      "include": ["tools/lint/**", "package.json", "bun.lock", "mise.toml"],
      "exclude": ["**/*.md"]
    },
    {
      "name": "Dead code and import boundaries",
      "command": "mise run fallow:dead-code",
      "details": "Check unused files, exports and dependencies, unresolved imports, cycles and layer boundaries.",
      "include": [
        "src/**",
        "tools/**",
        "tests/**",
        "package.json",
        "bun.lock",
        "mise.toml",
        "tsconfig.json",
        ".oxlintrc.json",
        ".fallowrc.jsonc",
        ".gitignore"
      ],
      "exclude": ["**/*.md"]
    },
    {
      "name": "Duplicate code",
      "command": "mise run fallow:dupes",
      "details": "Fail on qualifying duplicate groups.",
      "include": [
        "src/**",
        "tools/**",
        "tests/**",
        ".fallowrc.jsonc",
        ".gitignore",
        "package.json",
        "bun.lock",
        "mise.toml"
      ],
      "exclude": ["**/*.md"]
    }
  ],
  "commit": [
    {
      "name": "All application tests",
      "command": "mise run test:all",
      "details": "Run every application test, not only those affected by changed files."
    },
    {
      "name": "Compiled binary tests",
      "command": "mise run test:binary",
      "details": "Build the tau binary and drive its commands as a user would."
    }
  ]
}
